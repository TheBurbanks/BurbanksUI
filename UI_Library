function Library:addPage(data)
	data = data or {}

	local pageTitle = tostring(data.title or data.Title or "Page")
	local icon = data.icon or data.Icon

	local selfPage = setmetatable({}, Page)

	selfPage.library = self
	selfPage.title = pageTitle
	selfPage.sections = {}

	local button = create("TextButton", {
		Name = pageTitle,
		Parent = self.pagesContainer,
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
	})

	local selection = create("Frame", {
		Name = "Selection",
		Parent = button,
		Size = UDim2.new(1, 0, 1, 0),
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
	})

	bindTheme(self, selection, "BackgroundColor3", "LightContrast")
	addCorner(selection, 4)

	local iconOffset = icon and 32 or 10

	if icon then
		local iconImage = create("ImageLabel", {
			Name = "Icon",
			Parent = button,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(10, 8),
			Size = UDim2.fromOffset(16, 16),
			Image = "rbxassetid://" .. tostring(icon),
			ImageTransparency = 0.55,
		})

		bindTheme(self, iconImage, "ImageColor3", "TextColor")
		selfPage.icon = iconImage
	end

	local title = create("TextLabel", {
		Name = "Title",
		Parent = button,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(iconOffset, 0),
		Size = UDim2.new(1, -iconOffset - 6, 1, 0),
		Font = Enum.Font.Gotham,
		Text = pageTitle,
		TextSize = 12,
		TextTransparency = 0.45,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	bindTheme(self, title, "TextColor3", "TextColor")

	local container = create("ScrollingFrame", {
		Name = pageTitle,
		Parent = self.content,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 3,
		Visible = false,
		AutomaticCanvasSize = Enum.AutomaticSize.None,
	})

	bindTheme(self, container, "ScrollBarImageColor3", "LightContrast")

	local layout = create("UIListLayout", {
		Parent = container,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 9),
	})

	create("UIPadding", {
		Parent = container,
		PaddingRight = UDim.new(0, 5),
		PaddingBottom = UDim.new(0, 5),
	})

	refreshCanvas(container, layout, 10)

	selfPage.button = button
	selfPage.buttonTitle = title
	selfPage.selection = selection
	selfPage.container = container
	selfPage.layout = layout

	self.pages[#self.pages + 1] = selfPage
	button.LayoutOrder = #self.pages

	button.MouseButton1Click:Connect(function()
		self:SelectPage({
			page = selfPage,
			toggle = true,
		})
	end)

	if #self.pages == 1 then
		self:SelectPage({
			page = selfPage,
			toggle = true,
		})
	end

	return selfPage
end

Library.AddPage = Library.addPage

function Library:SelectPage(data)
	data = data or {}

	local selectedPage = data.page or data.Page

	if not selectedPage then
		return
	end

	if self.focusedPage == selectedPage then
		return
	end

	if self.focusedPage then
		local oldPage = self.focusedPage

		oldPage.container.Visible = false
		oldPage.buttonTitle.Font = Enum.Font.Gotham
		oldPage.buttonTitle.TextTransparency = 0.45
		oldPage.selection.BackgroundTransparency = 1

		if oldPage.icon then
			oldPage.icon.ImageTransparency = 0.55
		end
	end

	self.focusedPage = selectedPage
	selectedPage.container.Visible = true
	selectedPage.buttonTitle.Font = Enum.Font.GothamSemibold
	selectedPage.buttonTitle.TextTransparency = 0
	selectedPage.selection.BackgroundTransparency = 0

	if selectedPage.icon then
		selectedPage.icon.ImageTransparency = 0
	end
end

Library.selectPage = Library.SelectPage

function Page:setOrderPos(position)
	position = math.clamp(
		math.floor(tonumber(position) or 1),
		1,
		#self.library.pages
	)

	local pages = self.library.pages
	local currentPosition = table.find(pages, self)

	if currentPosition then
		table.remove(pages, currentPosition)
	end

	table.insert(pages, position, self)

	for index, pageObject in ipairs(pages) do
		pageObject.button.LayoutOrder = index
	end
end

