--// Button

function Section:addButton(data)
	data = data or {}

	local options = {
		title = tostring(data.title or data.Title or "Button"),
		callback = data.callback or data.Callback or function() end,
	}

	local module = createModuleBase(self, 32)
	local button = create("TextButton", {
		Parent = module,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Text = "",
		AutoButtonColor = false,
	})

	local title = createModuleTitle(self, button, options.title, 20)

	button.MouseButton1Click:Connect(function()
		tween(module, 0.08, {Size = UDim2.new(1, -6, 0, 32)})
		task.wait(0.08)
		tween(module, 0.08, {Size = UDim2.new(1, 0, 0, 32)})

		safeCallback(options.callback)
	end)

	local controller = {
		Instance = module,
		Options = options,
	}

	function controller:Update(newOptions)
		newOptions = newOptions or {}

		if newOptions.title ~= nil then
			options.title = tostring(newOptions.title)
			title.Text = options.title
		end

		if typeof(newOptions.callback) == "function" then
			options.callback = newOptions.callback
		end

		return self
	end

