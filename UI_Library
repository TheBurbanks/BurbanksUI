--// Slider

function Section:addSlider(data)
	data = data or {}

	local options = {
		title = tostring(data.title or data.Title or "Slider"),
		min = tonumber(data.min) or 0,
		max = tonumber(data.max) or 100,
		precision = tonumber(data.precision) or 0,
		value = tonumber(data.default),
		callback = data.callback or data.Callback or function() end,
	}

	if options.max <= options.min then
		options.max = options.min + 1
	end

	options.value = math.clamp(
		options.value or options.min,
		options.min,
		options.max
	)

	local module = createModuleBase(self, 50)
	local title = createModuleTitle(self, module, options.title, 65)

	title.Size = UDim2.new(1, -75, 0, 25)

	local valueBox = create("TextBox", {
		Parent = module,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 3),
		Size = UDim2.fromOffset(50, 22),
		BackgroundTransparency = 1,
		ClearTextOnFocus = false,
		Font = Enum.Font.GothamSemibold,
		Text = tostring(options.value),
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Right,
	})

	bindTheme(self.library, valueBox, "TextColor3", "TextColor")

	local bar = create("Frame", {
		Parent = module,
		Position = UDim2.fromOffset(10, 34),
		Size = UDim2.new(1, -20, 0, 5),
		BorderSizePixel = 0,
	})

	bindTheme(self.library, bar, "BackgroundColor3", "LightContrast")
	addCorner(bar, 3)

	local fill = create("Frame", {
		Parent = bar,
		Size = UDim2.new(0, 0, 1, 0),
		BorderSizePixel = 0,
	})

	bindTheme(self.library, fill, "BackgroundColor3", "TextColor")
	addCorner(fill, 3)

	local knob = create("Frame", {
		Parent = fill,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(10, 10),
		BorderSizePixel = 0,
	})

	bindTheme(self.library, knob, "BackgroundColor3", "TextColor")
	addCorner(knob, 5)

	local dragging = false

	local function setValue(value, callCallback)
		value = math.clamp(tonumber(value) or options.min, options.min, options.max)
		value = round(value, options.precision)

		options.value = value

		local percent = (value - options.min) / (options.max - options.min)

		valueBox.Text = tostring(value)
		tween(fill, 0.08, {
			Size = UDim2.new(percent, 0, 1, 0),
		})

		if callCallback ~= false then
			safeCallback(options.callback, value)
		end
	end

	local function updateFromMouse()
		local percentage = math.clamp(
			(UserInputService:GetMouseLocation().X - bar.AbsolutePosition.X)
				/ bar.AbsoluteSize.X,
			0,
			1
		)

		setValue(
			options.min + (options.max - options.min) * percentage,
			true
		)
	end

	module.InputBegan:Connect(function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			updateFromMouse()
		end
	end)

	UserInputService.InputChanged:Connect(function(inputObject)
		if dragging and inputObject.UserInputType == Enum.UserInputType.MouseMovement then
			updateFromMouse()
		end
	end)

	UserInputService.InputEnded:Connect(function(inputObject)
		if inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)

	valueBox.FocusLost:Connect(function()
		setValue(valueBox.Text, true)
	end)

	setValue(options.value, false)

	local controller = {
		Instance = module,
		Options = options,
	}

	function controller:Set(value, callCallback)
		setValue(value, callCallback)
		return self
	end

	function controller:Update(newOptions)
		newOptions = newOptions or {}

		if newOptions.title ~= nil then
			options.title = tostring(newOptions.title)
			title.Text = options.title
		end

		if newOptions.min ~= nil then
			options.min = tonumber(newOptions.min) or options.min
		end

		if newOptions.max ~= nil then
			options.max = tonumber(newOptions.max) or options.max
		end

		if newOptions.precision ~= nil then
			options.precision = tonumber(newOptions.precision) or options.precision
		end

		if typeof(newOptions.callback) == "function" then
			options.callback = newOptions.callback
		end

		if newOptions.value ~= nil then
			setValue(newOptions.value, false)
		elseif newOptions.default ~= nil then
			setValue(newOptions.default, false)
		else
			setValue(options.value, false)
		end

		return self
	end

	self.modules[#self.modules + 1] = controller
	return controller
end

