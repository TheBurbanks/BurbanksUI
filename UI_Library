--// Venyx-style UI Library
--// Designed to be returned from a loadstring
--// LocalScript / client-side only

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")

local LocalPlayer = Players.LocalPlayer

if not LocalPlayer then
	error("This UI library must be executed on the client.")
end

local Library = {}
Library.__index = Library

local Page = {}
Page.__index = Page

local Section = {}
Section.__index = Section

local DEFAULT_THEME = {
	Background = Color3.fromRGB(24, 24, 24),
	Glow = Color3.fromRGB(0, 0, 0),
	Accent = Color3.fromRGB(10, 10, 10),
	LightContrast = Color3.fromRGB(32, 32, 32),
	DarkContrast = Color3.fromRGB(17, 17, 17),
	TextColor = Color3.fromRGB(255, 255, 255),
	MutedText = Color3.fromRGB(155, 155, 155),
	Enabled = Color3.fromRGB(255, 255, 255),
}

local function cloneTable(source)
	local result = {}

	for key, value in pairs(source) do
		result[key] = value
	end

	return result
end

local function create(className, properties)
	local object = Instance.new(className)

	for property, value in pairs(properties or {}) do
		object[property] = value
	end

	return object
end

local function addCorner(object, radius)
	return create("UICorner", {
		Parent = object,
		CornerRadius = UDim.new(0, radius or 4),
	})
end

local function addStroke(object, color, transparency, thickness)
	return create("UIStroke", {
		Parent = object,
		Color = color or Color3.new(0, 0, 0),
		Transparency = transparency or 0,
		Thickness = thickness or 1,
	})
end

local function tween(object, duration, properties, style, direction)
	local tweenObject = TweenService:Create(
		object,
		TweenInfo.new(
			duration or 0.2,
			style or Enum.EasingStyle.Quad,
			direction or Enum.EasingDirection.Out
		),
		properties
	)

	tweenObject:Play()
	return tweenObject
end

local function getGuiParent()
	local success, result = pcall(function()
		if typeof(gethui) == "function" then
			return gethui()
		end

		return LocalPlayer:WaitForChild("PlayerGui")
	end)

	if success and result then
		return result
	end

	return LocalPlayer:WaitForChild("PlayerGui")
end

local function makeDraggable(handle, target)
	target = target or handle

	local dragging = false
	local dragStart
	local startPosition
	local activeInput

	handle.Active = true

	handle.InputBegan:Connect(function(inputObject)
		if inputObject.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end

		dragging = true
		dragStart = inputObject.Position
		startPosition = target.Position
		activeInput = inputObject
	end)

	UserInputService.InputChanged:Connect(function(inputObject)
		if not dragging then
			return
		end

		if inputObject.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end

		local delta = inputObject.Position - dragStart

		target.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end)

	UserInputService.InputEnded:Connect(function(inputObject)
		if inputObject == activeInput
			or inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
			activeInput = nil
		end
	end)
end

local function safeCallback(callback, ...)
	if typeof(callback) ~= "function" then
		return
	end

	local success, message = pcall(callback, ...)

	if not success then
		warn("[UI Library callback error]:", message)
	end
end

local function formatKey(keyCode)
	if keyCode == Enum.KeyCode.Unknown then
		return "None"
	end

	local text = UserInputService:GetStringForKeyCode(keyCode)

	if text == "" then
		return keyCode.Name
	end

	return text
end

local function round(number, precision)
	precision = precision or 0

	if precision == -1 then
		return number
	end

	local multiplier = 10 ^ precision
	return math.floor(number * multiplier + 0.5) / multiplier
end

local function bindTheme(window, object, property, themeName)
	window._themeObjects[#window._themeObjects + 1] = {
		Object = object,
		Property = property,
		Theme = themeName,
	}

	object[property] = window.theme[themeName]
end

local function refreshCanvas(scrollingFrame, listLayout, padding)
	padding = padding or 0

	local function update()
		scrollingFrame.CanvasSize = UDim2.fromOffset(
			0,
			listLayout.AbsoluteContentSize.Y + padding
		)
	end

	listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(update)
	update()
end

--// Window

function Library.new(data)
	data = data or {}

	local self = setmetatable({}, Library)

	self.title = tostring(data.title or data.Title or "Venyx")
	self.theme = cloneTable(DEFAULT_THEME)
	self.pages = {}
	self.focusedPage = nil
	self._themeObjects = {}
	self._connections = {}
	self._visible = true
	self._busy = false

	if typeof(data.theme) == "table" then
		for key, value in pairs(data.theme) do
			if self.theme[key] ~= nil and typeof(value) == "Color3" then
				self.theme[key] = value
			end
		end
	end

	local gui = create("ScreenGui", {
		Name = self.title,
		Parent = getGuiParent(),
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = false,
	})

	local main = create("Frame", {
		Name = "Main",
		Parent = gui,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(540, 430),
		BorderSizePixel = 0,
		ClipsDescendants = false,
	})

	bindTheme(self, main, "BackgroundColor3", "Background")
	addCorner(main, 7)

	local glow = addStroke(main, self.theme.Glow, 0.15, 2)
	bindTheme(self, glow, "Color", "Glow")

	local topBar = create("Frame", {
		Name = "TopBar",
		Parent = main,
		Size = UDim2.new(1, 0, 0, 42),
		BorderSizePixel = 0,
		ZIndex = 5,
	})

	bindTheme(self, topBar, "BackgroundColor3", "Accent")
	addCorner(topBar, 7)

	local topBarCover = create("Frame", {
		Parent = topBar,
		Position = UDim2.new(0, 0, 1, -7),
		Size = UDim2.new(1, 0, 0, 7),
		BorderSizePixel = 0,
		ZIndex = 5,
	})

	bindTheme(self, topBarCover, "BackgroundColor3", "Accent")

	local title = create("TextLabel", {
		Name = "Title",
		Parent = topBar,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(1, -90, 1, 0),
		Font = Enum.Font.GothamBold,
		Text = self.title,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 6,
	})

	bindTheme(self, title, "TextColor3", "TextColor")

	local minimize = create("TextButton", {
		Name = "Minimize",
		Parent = topBar,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(26, 26),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = "—",
		TextSize = 16,
		AutoButtonColor = false,
		ZIndex = 6,
	})

	bindTheme(self, minimize, "TextColor3", "TextColor")

	local sidebar = create("Frame", {
		Name = "Sidebar",
		Parent = main,
		Position = UDim2.fromOffset(0, 42),
		Size = UDim2.new(0, 140, 1, -42),
		BorderSizePixel = 0,
	})

	bindTheme(self, sidebar, "BackgroundColor3", "DarkContrast")

	local sidebarCorner = addCorner(sidebar, 7)

	local sidebarCover = create("Frame", {
		Parent = sidebar,
		Position = UDim2.fromOffset(133, 0),
		Size = UDim2.new(0, 7, 1, 0),
		BorderSizePixel = 0,
	})

	bindTheme(self, sidebarCover, "BackgroundColor3", "DarkContrast")

	local pageButtons = create("ScrollingFrame", {
		Name = "PageButtons",
		Parent = sidebar,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(8, 10),
