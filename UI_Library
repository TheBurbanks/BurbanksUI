	}

	function controller:Set(color, callCallback)
		if typeof(color) ~= "Color3" then
			return self
		end

		options.color3 = color
		updateInputs()

		if callCallback ~= false then
			safeCallback(options.callback, options.color3)
		end

		return self
	end

	function controller:Update(newOptions)
		newOptions = newOptions or {}

		if newOptions.title ~= nil then
			options.title = tostring(newOptions.title)
			title.Text = options.title
		end

		if typeof(newOptions.default) == "Color3" then
			self:Set(newOptions.default, false)
		elseif typeof(newOptions.color3) == "Color3" then
			self:Set(newOptions.color3, false)
		end

		if typeof(newOptions.callback) == "function" then
			options.callback = newOptions.callback
		end

		return self
	end

	self.modules[#self.modules + 1] = controller
	return controller
end

Section.AddColorPicker = Section.addColorPicker

return Library
