function Section:addKeybind(data)
	data = data or {}

	local options = {
		title = tostring(data.title or data.Title or "Keybind"),
		key = data.key or Enum.KeyCode.Unknown,
		gameProcessedEvent = data.gameProcessedEvent == true,
		callback = data.callback or data.Callback or function() end,
		changedCallback = data.changedCallback or function() end,
	}

	local module = createModuleBase(self, 32)
	local button = create("TextButton", {
		Parent = module,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Text = "",
		AutoButtonColor = false,
	})

	local title = createModuleTitle(self, button, options.title, 125)

	local keyDisplay = create("TextLabel", {
		Parent = button,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(100, 20),
		BorderSizePixel = 0,
		Font = Enum.Font.GothamSemibold,
		Text = formatKey(options.key),
		TextSize = 11,
	})

	bindTheme(self.library, keyDisplay, "BackgroundColor3", "LightContrast")
	bindTheme(self.library, keyDisplay, "TextColor3", "TextColor")
	addCorner(keyDisplay, 4)

	local listening = false

	button.MouseButton1Click:Connect(function()
		if listening then
			return
		end

		listening = true
		keyDisplay.Text = "..."

		task.spawn(function()
			local inputObject

			repeat
				inputObject = UserInputService.InputBegan:Wait()
			until inputObject.UserInputType == Enum.UserInputType.Keyboard

			if inputObject.KeyCode == Enum.KeyCode.Escape
				or inputObject.KeyCode == Enum.KeyCode.Backspace then
				options.key = Enum.KeyCode.Unknown
			else
				options.key = inputObject.KeyCode
			end

			keyDisplay.Text = formatKey(options.key)
			listening = false

			safeCallback(options.changedCallback, options.key)
		end)
	end)

	local keyConnection = UserInputService.InputBegan:Connect(function(inputObject, processed)
		if listening then
			return
		end

		if inputObject.KeyCode ~= options.key then
			return
		end

		if options.key == Enum.KeyCode.Unknown then
			return
		end

		if processed ~= options.gameProcessedEvent then
			return
		end

		safeCallback(options.callback)
	end)

	self.library._connections[#self.library._connections + 1] = keyConnection

	local controller = {
		Instance = module,
		Options = options,
	}

	function controller:SetKey(key)
		if typeof(key) == "InputObject" then
			key = key.KeyCode
		end

		if typeof(key) ~= "EnumItem" then
			key = Enum.KeyCode.Unknown
		end

		options.key = key
		keyDisplay.Text = formatKey(options.key)
		safeCallback(options.changedCallback, options.key)

		return self
	end

	function controller:Update(newOptions)
		newOptions = newOptions or {}

		if newOptions.title ~= nil then
			options.title = tostring(newOptions.title)
			title.Text = options.title
		end

		if newOptions.key ~= nil then
			self:SetKey(newOptions.key)
		end

		if newOptions.gameProcessedEvent ~= nil then
			options.gameProcessedEvent = newOptions.gameProcessedEvent == true
		end

		if typeof(newOptions.callback) == "function" then
			options.callback = newOptions.callback
		end

		if typeof(newOptions.changedCallback) == "function" then
			options.changedCallback = newOptions.changedCallback
		end

		return self
	end

	self.modules[#self.modules + 1] = controller
	return controller
end

