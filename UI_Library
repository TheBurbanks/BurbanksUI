	local opened = false

	local function setOpen(state)
		opened = state == true
		search.Visible = opened
		listFrame.Visible = opened

		tween(arrow, 0.18, {
			Rotation = opened and 180 or 0,
		})

		tween(module, 0.2, {
			Size = UDim2.new(1, 0, 0, opened and 170 or 32),
		})
	end

	local function clearEntries()
		for _, child in ipairs(listFrame:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
	end

	local function rebuild(filter)
		clearEntries()

		filter = tostring(filter or ""):lower()

		for _, value in ipairs(options.list) do
			if filter == "" or value:lower():find(filter, 1, true) then
				local entry = create("TextButton", {
					Parent = listFrame,
					Size = UDim2.new(1, -3, 0, 28),
					BorderSizePixel = 0,
					AutoButtonColor = false,
					Font = Enum.Font.Gotham,
					Text = value,
					TextSize = 11,
				})

				bindTheme(self.library, entry, "BackgroundColor3", "LightContrast")
				bindTheme(self.library, entry, "TextColor3", "TextColor")
				addCorner(entry, 4)

				entry.MouseButton1Click:Connect(function()
					options.selected = value
					title.Text = value
					setOpen(false)
					safeCallback(options.callback, value)
				end)
			end
		end
	end

	header.MouseButton1Click:Connect(function()
		setOpen(not opened)

		if opened then
			search.Text = ""
			rebuild("")
		end
	end)

	search:GetPropertyChangedSignal("Text"):Connect(function()
		if opened then
			rebuild(search.Text)
		end
	end)

	rebuild("")

	local controller = {
		Instance = module,
		Options = options,
	}

	function controller:Set(value, callCallback)
		value = tostring(value)

		options.selected = value
		title.Text = value

		if callCallback ~= false then
			safeCallback(options.callback, value)
		end

		return self
	end

	function controller:Update(newOptions)
		newOptions = newOptions or {}

		if newOptions.title ~= nil then
			options.title = tostring(newOptions.title)

			if not options.selected then
				title.Text = options.title
			end
		end

		if typeof(newOptions.list) == "table" then
			table.clear(options.list)

			for _, value in ipairs(newOptions.list) do
				options.list[#options.list + 1] = tostring(value)
			end

			rebuild(search.Text)
		end

		if newOptions.default ~= nil then
			self:Set(newOptions.default, false)
		elseif newOptions.selected ~= nil then
			self:Set(newOptions.selected, false)
		end

		if typeof(newOptions.callback) == "function" then
			options.callback = newOptions.callback
		end

		return self
	end

	self.modules[#self.modules + 1] = controller
	return controller
end

