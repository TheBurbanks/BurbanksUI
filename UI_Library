Library.CreateWindow = Library.new
Library.Create = Library.new

function Library:setTitle(newTitle)
	self.title = tostring(newTitle or "Venyx")
	self.container.Name = self.title
	self.titleLabel.Text = self.title
end

Library.SetTitle = Library.setTitle

function Library:setTheme(data, color)
	local themeName
	local themeColor

	if typeof(data) == "table" then
		themeName = data.theme or data.Theme
		themeColor = data.color3 or data.Color or data.color
	else
		themeName = data
		themeColor = color
	end

	if self.theme[themeName] == nil then
		warn("Unknown theme:", themeName)
		return false
	end

	if typeof(themeColor) ~= "Color3" then
		warn("Theme color must be a Color3.")
		return false
	end

	self.theme[themeName] = themeColor

	for _, themeObject in ipairs(self._themeObjects) do
		local object = themeObject.Object

		if object and object.Parent and themeObject.Theme == themeName then
			object[themeObject.Property] = themeColor
		end
	end

	return true
end

Library.SetTheme = Library.setTheme

function Library:toggle(forceState)
	if self._busy then
		return
	end

	if forceState ~= nil then
		self._visible = forceState == true
	else
		self._visible = not self._visible
	end

	self._busy = true

	if self._visible then
		self.main.Visible = true
		self.main.ClipsDescendants = true
		self.main.Size = UDim2.fromOffset(self.openSize.X.Offset, 0)

		tween(self.main, 0.22, {
			Size = self.openSize,
			Position = self.openPosition,
		}).Completed:Wait()

		self.main.ClipsDescendants = false
	else
		self.openPosition = self.main.Position
		self.openSize = self.main.Size
		self.main.ClipsDescendants = true

		tween(self.main, 0.22, {
			Size = UDim2.fromOffset(self.main.AbsoluteSize.X, 0),
			Position = self.main.Position + UDim2.fromOffset(0, self.main.AbsoluteSize.Y / 2),
		}).Completed:Wait()

		self.main.Visible = false
	end

	self._busy = false
end

Library.Toggle = Library.toggle

function Library:Destroy()
	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end

	self.container:Destroy()
end

function Library:Notify(data)
	data = data or {}

	local notificationTitle = tostring(data.title or data.Title or "Notification")
	local notificationText = tostring(data.text or data.Text or "")
	local callback = data.callback or data.Callback

	local holder = create("Frame", {
		Name = "Notification",
		Parent = self.container,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 14, 1, -14),
		Size = UDim2.fromOffset(0, 70),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 30,
	})

	bindTheme(self, holder, "BackgroundColor3", "Background")
	addCorner(holder, 6)

	local stroke = addStroke(holder, self.theme.Glow, 0.15, 1)
	bindTheme(self, stroke, "Color", "Glow")

	local title = create("TextLabel", {
		Parent = holder,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 8),
		Size = UDim2.new(1, -72, 0, 18),
		Font = Enum.Font.GothamSemibold,
		Text = notificationTitle,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 31,
	})

	bindTheme(self, title, "TextColor3", "TextColor")

	local text = create("TextLabel", {
		Parent = holder,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 29),
		Size = UDim2.new(1, -72, 0, 30),
		Font = Enum.Font.Gotham,
		Text = notificationText,
		TextSize = 11,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 31,
	})

	bindTheme(self, text, "TextColor3", "MutedText")

	local accept = create("TextButton", {
		Parent = holder,
		Position = UDim2.new(1, -56, 0, 8),
		Size = UDim2.fromOffset(22, 22),
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = "✓",
		TextSize = 13,
		AutoButtonColor = false,
		ZIndex = 31,
	})

	bindTheme(self, accept, "BackgroundColor3", "LightContrast")
	bindTheme(self, accept, "TextColor3", "TextColor")
	addCorner(accept, 4)

	local decline = create("TextButton", {
		Parent = holder,
		Position = UDim2.new(1, -30, 0, 8),
		Size = UDim2.fromOffset(22, 22),
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = "×",
		TextSize = 14,
		AutoButtonColor = false,
		ZIndex = 31,
	})

	bindTheme(self, decline, "BackgroundColor3", "LightContrast")
	bindTheme(self, decline, "TextColor3", "TextColor")
	addCorner(decline, 4)

	local measured = TextService:GetTextSize(
		notificationText,
		11,
		Enum.Font.Gotham,
		Vector2.new(260, 30)
	)

	local width = math.clamp(measured.X + 95, 220, 340)
	tween(holder, 0.2, {Size = UDim2.fromOffset(width, 70)})

	local closed = false

	local function close(result)
		if closed then
			return
		end

		closed = true
		safeCallback(callback, result)

		tween(holder, 0.2, {
			Size = UDim2.fromOffset(0, 70),
			Position = holder.Position - UDim2.fromOffset(20, 0),
		}).Completed:Wait()

		holder:Destroy()
	end

	accept.MouseButton1Click:Connect(function()
		close(true)
	end)

	decline.MouseButton1Click:Connect(function()
		close(false)
	end)

	if data.duration then
		task.delay(tonumber(data.duration) or 5, function()
			if holder.Parent then
				close(nil)
			end
		end)
	end

	return {
		Close = close,
		Instance = holder,
	}
end

